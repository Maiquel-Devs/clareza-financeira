                },
                {
                    "ruleId": "MissingApplicationIcon",
                    "ruleIndex": 1,
                    "message": {
                        "text": "Should explicitly set android:icon, there is no default",
                        "markdown": "Should explicitly set `android:icon`, there is no default"
                    },
                    "locations": [
                        {
                            "physicalLocation": {
                                "artifactLocation": {
                                    "uriBaseId": "%SRCROOT%",
                                    "uri": "app/src/main/AndroidManifest.xml"
