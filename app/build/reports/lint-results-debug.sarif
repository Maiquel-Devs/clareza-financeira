                                        "text": "https\\://services.gradle.org/distributions/gradle-9.5.0-bin.zip"
                                    }
                                },
                                "contextRegion": {
                                    "startLine": 1,
                                    "endLine": 6,
                                    "snippet": {
                                        "text": "distributionBase=GRADLE_USER_HOME\ndistributionPath=wrapper/dists\ndistributionUrl=https\\://services.gradle.org/distributions/gradle-9.5.0-bin.zip\nnetworkTimeout=10000\nretries=0\n"
                                    }
                                }
                            }
                        }
                    ],
                    "fixes": [
                        {
