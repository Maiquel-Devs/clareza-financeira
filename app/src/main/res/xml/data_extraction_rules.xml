<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- No app files go to cloud backup, including any future persistence. -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Allowlist the complete financial database, not every future database/file.
             Android also handles the associated SQLite journal/WAL files. -->
        <include domain="database" path="clareza-financeira.db" />
    </device-transfer>
</data-extraction-rules>
